# Global/Default SSH Credentials
SSH_USERNAME=admin
SSH_PASSWORD=your_password
SSH_SECRET=your_enable_password

# Monitored Targets (host:device_type)
TARGET_DEVICES=192.168.1.1:cisco_ios,192.168.1.2:juniper_junos,10.0.0.1:arista_eos

# Polling interval in seconds
POLL_INTERVAL=10

# Webhook Configuration
# Provider options: google_chat | discord | slack
WEBHOOK_PROVIDER=discord
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL